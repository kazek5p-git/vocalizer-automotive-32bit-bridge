msgstr "S'ha produciu una error en copiar os datos d'a licencia: {error}"

#, python-brace-format
msgid "Error removing license: {error}"
msgstr "S'ha produciu una error en sacar a licencia: {error}"

msgid "License Number: "
msgstr "Numero de Licencia: "

msgid ""
"License entered successfully!\n"
"For all changes to take effect NVDA must be restarted.\n"
"Do you want to restart NVDA now?"
msgstr ""
"A licencia se'n ye introducida satisfactoriament!\n"
"Ta que totz os cambeos tiengan efecto cal reenchegar NVDA.\n"
"Quiers reenchegar agora o NVDA?"

msgid "License file found, but detailed information is unavailable."
msgstr "Os datos d'a licencia no son disponibles"

msgid "License removed. Restart NVDA for the change to take effect."
msgstr ""
"A licencia se'n ye sacada satisfactoriament. Reenchega NVDA ta que os "
"cambeos tiengan efecto."

msgid ""
"License validity is checked by the 32-bit Automotive host. Detailed license "
"errors are not available through the current 64/32-bit bridge."
msgstr ""

msgid "Locale Name:"
msgstr "Nombre d'a Localización:"

msgid "No Automotive voice resources were found."
msgstr "No bi ha voces instaladas."

msgid "No License."
msgstr "No bi ha Licencia."

