msgid "About Nuance Vocalizer for NVDA"
msgstr "Acerca do Nuance Vocalizer para o NVDA"

msgid ""
"Are you sure you want to remove your license?\n"
"This can not be reverted."
msgstr ""
"Tem a certeza que pretende remover a sua licença?\n"
"Esta operação não pode ser anulada."

msgid "Automatic &Language Switching Settings"
msgstr "Definições de Mudança Automática de &idioma"

msgid "Choose license file"
msgstr "Escolha o ficheiro da licença"

