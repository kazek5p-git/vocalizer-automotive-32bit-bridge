msgstr "Abre a página onde pode transferir mais vozes para o vocalizer."

msgid "Remove License"
msgstr "Remover Licença"

msgid "Remove License?"
msgstr "Remover a Licença?"

msgid "Remove your license from this NVDA copy"
msgstr "Remove a sua licença desta cópia do NVDA"

