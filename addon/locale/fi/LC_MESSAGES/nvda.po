msgstr "Virhe"

#, python-brace-format
msgid "Error copying license data: {error}"
msgstr "Virhe kopioitaessa lisenssitietoja: {error}"

#, python-brace-format
msgid "Error removing license: {error}"
msgstr "Virhe poistettaessa lisenssiä: {error}"

msgid "License Number: "
msgstr "Lisenssinumero: "

msgid ""
"License entered successfully!\n"
"For all changes to take effect NVDA must be restarted.\n"
"Do you want to restart NVDA now?"
msgstr ""
"Lisenssitiedot syötetty onnistuneesti!\n"
"NVDA on käynnistettävä uudelleen, jotta kaikki muutokset tulevat voimaan.\n"
"Käynnistetäänkö se uudelleen nyt?"

msgid "License file found, but detailed information is unavailable."
msgstr "Lisenssitietoja ei ole käytettävissä"

msgid "License removed. Restart NVDA for the change to take effect."
msgstr ""
"Lisenssi poistettu onnistuneesti. Käynnistä NVDA uudelleen, jotta muutokset "
"tulevat voimaan."

msgid ""
"License validity is checked by the 32-bit Automotive host. Detailed license "
"errors are not available through the current 64/32-bit bridge."
msgstr ""

msgid "Locale Name:"
msgstr "Kieli:"

msgid "No Automotive voice resources were found."
msgstr "Puheääniä ei ole asennettu."

msgid "No License."
msgstr "Ei lisenssiä."

