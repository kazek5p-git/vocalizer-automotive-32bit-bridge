msgid "No voices installed."
msgstr "لا توجد أصوات مثبتة على الحاسوب."

msgid "Nuance Vocalizer license files"
msgstr "ملفات ترخيص Nuance Vocalizer"

msgid "Open the vocalizer voices download page."
msgstr "افتح صفحة تحميل أصوات Vocalizer"

msgid "Remove License"
msgstr "حذف النسخة"

msgid "Remove License?"
msgstr "حذف الترخيص؟"

msgid "Remove your license from this NVDA copy"
msgstr "قم بحذف هذه النسخة من إصدار NVDA المثبت حاليا"

msgid "Select a language, and then configure the voice to be used:"
msgstr "اختر البلد, ثم اختر الصوت المناسب:"

msgid "Success!"
msgstr "تم!"

