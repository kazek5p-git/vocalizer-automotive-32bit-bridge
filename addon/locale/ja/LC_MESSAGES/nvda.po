msgstr "ライセンス消去の失敗: {error}"

msgid "License Number: "
msgstr "ライセンス番号: "

msgid ""
"License entered successfully!\n"
"For all changes to take effect NVDA must be restarted.\n"
"Do you want to restart NVDA now?"
msgstr ""
"ライセンスが入力されました。\n"
"有効にするためにNVDAを再起動してください。\n"
"NVDAを再起動しますか？"

msgid "License file found, but detailed information is unavailable."
msgstr "ライセンスが有効ではありません"

msgid "License removed. Restart NVDA for the change to take effect."
msgstr "ライセンスを消去しました。NVDAを再起動してください。"

