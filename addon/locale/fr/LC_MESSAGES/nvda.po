msgid ""
"Are you sure you want to remove your license?\n"
"This can not be reverted."
msgstr ""
"Êtes-vous sûr de vouloir retirer votre licence ?\n"
"Ceci est irréversible, assurez-vous d'avoir une copie de sauvegarde de votre "
"licence en lieu sûr."

msgid "Automatic &Language Switching Settings"
msgstr "Paramètres du changement automatique de &langue"

