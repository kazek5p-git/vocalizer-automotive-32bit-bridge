msgstr "Μεταφορτώστε Περισσότερες Φωνές"

msgid "Enter License"
msgstr "Εισάγετε την Άδεια"

msgid "Enter your license data for this computer."
msgstr "Εισάγετε τα δεδομένα της άδειας σας για αυτόν τον υπολογιστή."

msgid "Entering License Data:"
msgstr "Εισαγωγή Δεδομένων Άδειας:"

msgid "Error"
msgstr "Σφάλμα"

#, python-brace-format
msgid "Error copying license data: {error}"
msgstr "Σφάλμα κατά την αντιγραφή των δεδομένων της άδειας: {error}"

#, python-brace-format
msgid "Error removing license: {error}"
msgstr "Σφάλμα κατά την απομάκρυνση της άδειας: {error}"

msgid "License Number: "
msgstr "Αριθμός Άδειας:"

msgid ""
"License entered successfully!\n"
"For all changes to take effect NVDA must be restarted.\n"
"Do you want to restart NVDA now?"
msgstr ""
"Η άδεια εισήχθηκε με επιτυχία!\n"
"Για την ενεργοποίηση των αλλαγών πρέπει να επανεκκινήσετε το NVDA.\n"
"Θέλετε να επανεκκινήσετε το NVDA τώρα;"

msgid "License file found, but detailed information is unavailable."
msgstr "Δεν είναι διαθέσιμα τα δεδομένα της άδειας"

msgid "License removed. Restart NVDA for the change to take effect."
msgstr ""
"Η άδεια απομακρύνθηκε με επιτυχία. Επανεκκινήστε το NVDA ώστε να "
"ενεργοποιηθούν οι αλλαγές."

msgid ""
"License validity is checked by the 32-bit Automotive host. Detailed license "
"errors are not available through the current 64/32-bit bridge."
msgstr ""

