msgid "No voices installed."
msgstr "Δεν υπάρχουν εγκατεστημένες φωνές."

msgid "Nuance Vocalizer license files"
msgstr "Nuance Vocalizer license files"

msgid "Open the vocalizer voices download page."
msgstr "Επισκεφτείτε την ιστοσελίδα μεταφόρτωσης φωνών του Vocalizer."

